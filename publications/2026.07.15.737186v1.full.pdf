         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Browser-based mouse brain atlas registration, selected-color signal-pixel quantification, regional mapping, and whole-brain-surface 3D visualization</rdf:li>
            </rdf:Alt>
         </dc:description>
